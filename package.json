{
  "name": "@stardustlc/dsh-suite",
  "version": "0.12.6",
  "description": "DeepSeek Harness 插件组合包：一次安装 18 个独立插件（含 9 个支持 5 套工作台主题的原生面板），支持整包同步与热重载。欢迎提交 issues 和 PR。",
  "type": "module",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./ptc-minimal.patch.yml"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "ptc-minimal.patch.yml",
    "docs/validation-2026-09-27.md",
    "docs/validation-2026-10-01.md",
    "docs/validation-2026-10-01-calendar-rss.md",
    "docs/validation-2026-10-01-ppt.md",
    "docs/validation-2026-10-02-email.md",
    "docs/validation-2026-10-02-rss.md",
    "docs/validation-2026-10-02-rss-vpn.md",
    "docs/validation-2026-10-02-top-downloads.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp",
    "locale"
  ],
  "scripts": {
    "build": "node --check scripts/smoke-harness.mjs && node --check scripts/verify-local.mjs && node --check scripts/verify-compat.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node scripts/verify-local.mjs",
    "verify:contracts": "node scripts/verify-local.mjs --contracts-only",
    "verify:compat": "node scripts/verify-compat.mjs"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "agent-tools",
    "llm-tools",
    "plugin",
    "bundle",
    "suite",
    "toolkit",
    "email",
    "imap",
    "calendar",
    "caldav",
    "pptx",
    "presentation",
    "rss",
    "citation",
    "agent-memory",
    "ffmpeg",
    "remotion",
    "docker",
    "sql",
    "code-security",
    "slack",
    "dingtalk",
    "tts",
    "whisper",
    "深度求索",
    "插件合集",
    "邮件",
    "日历",
    "演示文稿"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "dependencies": {
    "@stardustlc/dsh-docker": "0.5.17",
    "@stardustlc/dsh-dream": "0.16.6",
    "dsh-calendar": "0.18.6",
    "dsh-cite": "0.10.3",
    "dsh-code-security": "0.8.6",
    "dsh-codex-port": "0.4.16",
    "dsh-dingtalk": "0.4.2",
    "dsh-email": "0.28.7",
    "dsh-ffmpeg": "0.7.15",
    "dsh-flakefinder": "0.4.18",
    "dsh-hyperframes": "0.12.5",
    "dsh-minimal-ptc": "0.6.16",
    "dsh-ppt": "0.24.1",
    "dsh-remotion": "0.11.5",
    "dsh-rss": "0.10.6",
    "dsh-slack": "0.5.2",
    "dsh-sql": "0.6.2",
    "dsh-voice": "0.8.1"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-suite.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-suite/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-suite#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./ptc-minimal.patch.yml": "./ptc-minimal.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/plugin-icon.webp"
  }
}
