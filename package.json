{
  "name": "@stardustlc/dsh-suite",
  "version": "0.2.13",
  "description": "DSH 插件全家桶：18 个组件覆盖邮件、日历、媒体创作、开发运维、消息通知与极简 PTC，一条命令安装。",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./ptc-minimal.patch.yml"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "ptc-minimal.patch.yml",
    "docs/validation-2026-09-27.md",
    "docs/validation-2026-10-01.md",
    "docs/validation-2026-10-01-calendar-rss.md",
    "docs/validation-2026-10-01-ppt.md",
    "docs/validation-2026-10-02-email.md",
    "docs/validation-2026-10-02-rss.md",
    "docs/validation-2026-10-02-rss-vpn.md"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node scripts/verify-local.mjs",
    "verify:contracts": "node scripts/verify-local.mjs --contracts-only",
    "verify:compat": "node scripts/verify-compat.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "bundle",
    "suite",
    "toolkit"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "@stardustlc/dsh-docker": "0.3.4",
    "@stardustlc/dsh-dream": "0.6.0",
    "dsh-calendar": "0.9.3",
    "dsh-cite": "0.3.5",
    "dsh-code-security": "0.3.6",
    "dsh-codex-port": "0.2.4",
    "dsh-dingtalk": "0.2.2",
    "dsh-email": "0.14.6",
    "dsh-ffmpeg": "0.4.4",
    "dsh-flakefinder": "0.3.4",
    "dsh-hyperframes": "0.4.2",
    "dsh-minimal-ptc": "0.5.2",
    "dsh-ppt": "0.6.0",
    "dsh-remotion": "0.3.4",
    "dsh-rss": "0.5.1",
    "dsh-slack": "0.3.3",
    "dsh-sql": "0.4.4",
    "dsh-voice": "0.3.5"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-suite.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-suite/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-suite#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0"
}
