{
  "name": "@stardustlc/dsh-suite",
  "version": "0.9.1",
  "description": "DSH 组合包：一次安装 18 个独立插件，覆盖邮件、日历、记忆、媒体与开发工具；更新由用户选择。欢迎提交 issues 和 PR。",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./ptc-minimal.patch.yml"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "ptc-minimal.patch.yml",
    "docs/validation-2026-09-27.md",
    "docs/validation-2026-10-01.md",
    "docs/validation-2026-10-01-calendar-rss.md",
    "docs/validation-2026-10-01-ppt.md",
    "docs/validation-2026-10-02-email.md",
    "docs/validation-2026-10-02-rss.md",
    "docs/validation-2026-10-02-rss-vpn.md",
    "docs/validation-2026-10-02-top-downloads.md",
    "docs",
    "CHANGELOG.md",
    "assets/plugin-icon.webp"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "verify": "node scripts/verify-local.mjs",
    "verify:contracts": "node scripts/verify-local.mjs --contracts-only",
    "verify:compat": "node scripts/verify-compat.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "bundle",
    "suite",
    "toolkit"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.3"
  },
  "dependencies": {
    "@stardustlc/dsh-docker": "0.5.6",
    "@stardustlc/dsh-dream": "0.13.6",
    "dsh-calendar": "0.14.2",
    "dsh-cite": "0.7.6",
    "dsh-code-security": "0.7.7",
    "dsh-codex-port": "0.4.6",
    "dsh-dingtalk": "0.3.6",
    "dsh-email": "0.21.1",
    "dsh-ffmpeg": "0.7.3",
    "dsh-flakefinder": "0.4.7",
    "dsh-hyperframes": "0.11.2",
    "dsh-minimal-ptc": "0.6.6",
    "dsh-ppt": "0.20.2",
    "dsh-remotion": "0.10.2",
    "dsh-rss": "0.9.7",
    "dsh-slack": "0.4.6",
    "dsh-sql": "0.5.8",
    "dsh-voice": "0.5.3"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/STARDUSTLC666/dsh-suite.git"
  },
  "bugs": {
    "url": "https://github.com/STARDUSTLC666/dsh-suite/issues"
  },
  "homepage": "https://github.com/STARDUSTLC666/dsh-suite#readme",
  "author": "stardustlc",
  "packageManager": "pnpm@11.7.0",
  "icon": "./assets/plugin-icon.webp"
}
